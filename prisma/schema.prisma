datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DEVELOPER
  REPORTER
  QA
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Priority {
  P0
  P1
  P2
  P3
}

enum BugStatus {
  NEW
  TRIAGED
  IN_PROGRESS
  IN_REVIEW
  RESOLVED
  CLOSED
  REOPENED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(REPORTER)
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  reportedBugs  Bug[]          @relation("ReporterRelation")
  assignedBugs  Bug[]          @relation("AssigneeRelation")
  watchedBugs   Bug[]          @relation("BugWatchers")
  comments      Comment[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  attachments   Attachment[]
}

model Project {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  components  Component[]
  bugs        Bug[]
}

model Component {
  id          String   @id @default(uuid())
  name        String
  description String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bugs        Bug[]

  @@unique([name, projectId])
}

model Bug {
  id                Int          @id @default(autoincrement())
  title             String
  description       String
  stepsToReproduce  String?
  expectedBehavior  String?
  actualBehavior    String?
  severity          Severity     @default(MEDIUM)
  priority          Priority     @default(P2)
  status            BugStatus    @default(NEW)
  tags              String[]     @default([])
  dueDate           DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  projectId         String
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  componentId       String
  component         Component    @relation(fields: [componentId], references: [id], onDelete: Cascade)

  reporterId        String
  reporter          User         @relation("ReporterRelation", fields: [reporterId], references: [id])

  assigneeId        String?
  assignee          User?        @relation("AssigneeRelation", fields: [assigneeId], references: [id])

  watchers          User[]       @relation("BugWatchers")
  comments          Comment[]
  attachments       Attachment[]
  activityLogs      ActivityLog[]
  notifications     Notification[]

  // Self-relations for bug links: dependencies, blocking, duplicates
  blocking          BugRelation[] @relation("BlockingBugs")
  blockedBy         BugRelation[] @relation("BlockedByBugs")

  duplicateOfId     Int?
  duplicateOf       Bug?         @relation("Duplicates", fields: [duplicateOfId], references: [id])
  duplicates        Bug[]        @relation("Duplicates")
}

model BugRelation {
  id            String   @id @default(uuid())
  bugId         Int      // The bug that is blocked
  blockedById   Int      // The bug that is blocking bugId

  bug           Bug      @relation("BlockedByBugs", fields: [bugId], references: [id], onDelete: Cascade)
  blockedBy     Bug      @relation("BlockingBugs", fields: [blockedById], references: [id], onDelete: Cascade)

  @@unique([bugId, blockedById])
}

model Comment {
  id        String   @id @default(uuid())
  bugId     Int
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())
}

model Attachment {
  id          String   @id @default(uuid())
  bugId       Int
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  filename    String
  url         String
  uploadedById String
  uploadedBy  User     @relation(fields: [uploadedById], references: [id])
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(uuid())
  bugId       Int
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  field       String
  oldValue    String?
  newValue    String?
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  timestamp   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bugId     Int
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
